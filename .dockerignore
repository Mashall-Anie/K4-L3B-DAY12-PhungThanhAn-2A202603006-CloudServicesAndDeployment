# CP2 — những thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = nướng secret vào image; bỏ sót .git = image phình to.

# Secret — TUYỆT ĐỐI không cho vào image
.env
.env.*

# Git & metadata
.git
.gitignore
.gitattributes

# Môi trường ảo & cache Python
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
*.egg-info

# CI/CD
.github

# Không cần trong image production
tests
screenshots
nginx
solution
*.log
*.md
.DS_Store
.idea
.vscode
